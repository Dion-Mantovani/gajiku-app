---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Absensi & Gaji PWA' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex justify-center bg-slate-900">
    <!-- Mobile App Container Shell (Maksimal lebar ala mobile screen di desktop, full di HP) -->
    <div class="w-full max-w-md min-h-screen bg-slate-50 flex flex-col shadow-2xl relative overflow-x-hidden">
      <!-- Main Content Slot -->
      <main class="flex-1 pb-24">
        <slot />
      </main>

      <!-- Bottom Navigation Bar (Akan kita buat komponennya nanti) -->
      <slot name="nav" />

      <!-- Modal Slot (Global Modals) -->
      <slot name="modal" />
    </div>
  </body>
</html>
